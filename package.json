{
  "name": "radix-outdoor",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --env local --port 4173",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tests scripts *.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env local",
    "db:seed": "node scripts/seed-local.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --env local --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.10.1",
    "htmx.org": "^2.0.11",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
